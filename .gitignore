# 依赖与包管理器缓存（两个子项目各自安装，因此这些规则要覆盖到任意层级）
node_modules/
.npm-cache/
.pnpm-store/
.pnpm-home/

# 构建产物：根目录 dist/ 是 scripts/build-pages.mjs 合并出来的发布目录
# （里面包含两个子站的构建结果，子项目自己的 dist/ 也会被忽略）
dist/

# 部署安装用 npm（EdgeOne Pages）：package-lock.json 要提交，
# 这样 `npm ci` 装到的版本和本地验证过的一致；本地开发仍以 pnpm-lock.yaml 为准

# 类型检查缓存
*.tsbuildinfo

# 构建脚本/浏览器自检用的临时目录（.tmp-build、.tmp-edge-profile* 等）
.tmp-*/

# 天文自检的中间产物（由 scripts/verify-astro.cjs 重新生成）
.verify/
.verify-package.json

# 无头浏览器调试用的临时配置目录（脚本每次运行都会新建一个 .edge-xxx-profile）
.edge-*/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# EdgeOne CLI 本地元数据与拉取的环境变量（edgeone makers link 生成）
.edgeone/
.env
.env.local

