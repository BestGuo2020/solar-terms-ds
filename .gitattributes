# 统一换行符，避免 Windows / macOS / Linux 之间来回转换产生无意义的 diff
* text=auto eol=lf

# 二进制资源，不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 纹理虽然是图片，但体积较大，GitHub 语言统计时按二进制处理即可
public/textures/* binary

# 这些文件在 GitHub 上按语言高亮
*.ts   text
*.vue  text
*.css  text
*.md   text

# 包管理器锁文件：合并时容易冲突，且必须保持原样
pnpm-lock.yaml -diff merge=ours linguist-generated

# 截图属于生成产物，不计入语言统计
shots/* linguist-generated
