{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": ".verify",
    "rootDir": "src",
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/astro/**/*.ts",
    "src/data/terms.ts",
    "src/data/termDetails.ts",
    "src/data/song.ts",
    "src/data/history.ts",
    "src/data/culture.ts",
    "src/data/science.ts",
    "src/data/sources.ts",
    "src/data/en/**/*.ts"
  ]
}
